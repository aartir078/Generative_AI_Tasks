        "    max_new_tokens=80,\n",
        "    num_return_sequences=1,\n",
        "    do_sample=True,\n",
        "    temperature=0.8,\n",
        "    pad_token_id=50256\n",
        ")\n",
        "\n",
        "print(result[0][\"generated_text\"])"

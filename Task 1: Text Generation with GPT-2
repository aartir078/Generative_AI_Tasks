      "source": [
        "import torch\n",
        "from datasets import Dataset\n",
        "from transformers import (\n",
        "    AutoTokenizer,\n",
        "    AutoModelForCausalLM,\n",
        "    DataCollatorForLanguageModeling,\n",
        "    Trainer,\n",
        "    TrainingArguments\n",
        ")\n",
        "\n",
        "# 1. Load the pretrained GPT-2 tokenizer and model\n",
        "model_name = \"gpt2\"\n",
        "\n",
        "tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
        "tokenizer.pad_token = tokenizer.eos_token\n",
        "\n",
        "model = AutoModelForCausalLM.from_pretrained(model_name)\n",
        "model.config.pad_token_id = tokenizer.pad_token_id\n",
        "\n",
        "# 2. Convert our custom text into a dataset\n",
        "dataset = Dataset.from_dict({\"text\": custom_texts})\n",
        "\n",
        "# 3. Tokenize the training examples\n",
        "def tokenize_data(examples):\n",
        "    return tokenizer(\n",
        "        examples[\"text\"],\n",
        "        truncation=True,\n",
        "        max_length=128\n",
        "    )\n",
        "\n",
        "tokenized_dataset = dataset.map(\n",
        "    tokenize_data,\n",
        "    batched=True,\n",
        "    remove_columns=[\"text\"]\n",
        ")\n",
        "\n",
        "# 4. Prepare the data for language-model training\n",
        "data_collator = DataCollatorForLanguageModeling(\n",
        "    tokenizer=tokenizer,\n",
        "    mlm=False\n",
        ")\n",
        "\n",
        "# 5. Set training parameters\n",
        "training_args = TrainingArguments(\n",
        "    output_dir=\"./gpt2-training\",\n",
        "    num_train_epochs=5,\n",
        "    per_device_train_batch_size=2,\n",
        "    learning_rate=5e-5,\n",
        "    logging_steps=1,\n",
        "    save_strategy=\"no\",\n",
        "    report_to=\"none\",\n",
        "    fp16=torch.cuda.is_available()\n",
        ")\n",
        "\n",
        "# 6. Fine-tune the model\n",
        "trainer = Trainer(\n",
        "    model=model,\n",
        "    args=training_args,\n",
        "    train_dataset=tokenized_dataset,\n",
        "    data_collator=data_collator\n",
        ")\n",
        "\n",
        "trainer.train()\n",
        "\n",
        "# 7. Save the fine-tuned model and tokenizer\n",
        "output_dir = \"./gpt2-finetuned-custom\"\n",
        "\n",
        "trainer.save_model(output_dir)\n",
        "tokenizer.save_pretrained(output_dir)\n",
        "\n",
        "print(\"Fine-tuning completed!\")\n",
        "print(\"Model saved to:\", output_dir)"
      ],
